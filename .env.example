# 호박(Hobak) 중고거래 웹서비스 - 환경변수 예시 파일 (.env.example)
# 실제 사용 시 이 파일을 .env로 복사한 뒤 본인의 키를 입력하세요.
# 주의: .env 파일은 절대 GitHub에 업로드하지 마세요!

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-do-not-commit
SUPABASE_ACCESS_TOKEN=your-personal-access-token-do-not-commit
GITHUB_TOKEN=ghp_your-github-personal-access-token-do-not-commit
